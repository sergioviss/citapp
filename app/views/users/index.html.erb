<%= render 'shared/admin_datatable_assets' %>

<div x-data="usersList">
  <div class="flex items-center justify-end mb-4">
    <button type="button" class="btn btn-primary gap-2" @click="openCreateModal()">
      <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      Agregar Usuario
    </button>
  </div>

  <div class="panel px-4 border-[#e0e6ed] dark:border-[#1b2e4b]">
    <%= render_admin_datatable_toolbar(User, export_url: export_users_path(format: :xlsx)) %>

    <div class="invoice-table table-responsive">
      <table id="usersTable" class="table-hover w-full">
        <thead>
          <tr>
            <th class="!px-4 !py-2">Nombre</th>
            <th class="!px-4 !py-2">Email</th>
            <th class="!px-4 !py-2">Rol</th>
            <th class="!px-4 !py-2">Acciones</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>

  <%= render 'shared/create_record_modal',
      title: 'Agregar Usuario',
      errors_id: 'create-user-errors',
      body: render('form', user: @user, modal: true, form_title: 'Registrar', mode: 'new', roles: @roles) %>

  <%= render 'shared/record_modal', errors_id: 'record-modal-errors' %>
</div>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('usersList', () => ({
      showCreateModal: false,
      ...AdminDatatable.recordModalMixin('#record-modal-errors'),

      init() {
        $(document).ready(() => {
          AdminDatatable.setupFilters('#usersTable');
          this.initializeDataTable();
          AdminDatatable.bindModalForm('#create-user-form', {
            onSuccess: () => {
              this.closeCreateModal();
              AdminDatatable.reload('#usersTable');
            },
            onError: (payload) => {
              AdminDatatable.showFormErrors('#create-user-errors', payload.errors);
            }
          });
          AdminDatatable.bindRecordActions('#usersTable', {
            errorsId: '#record-modal-errors'
          });
        });
      },

      openCreateModal() {
        AdminDatatable.showFormErrors('#create-user-errors', []);
        this.showCreateModal = true;
      },

      closeCreateModal() {
        this.showCreateModal = false;
        AdminDatatable.showFormErrors('#create-user-errors', []);
        const form = document.querySelector('#create-user-form');
        if (form) form.reset();
      },

      initializeDataTable() {
        $('#usersTable').DataTable({
          ...AdminDatatable.tableDefaults,
          serverSide: true,
          processing: true,
          ajax: {
            url: '<%= datatable_users_path %>',
            data: (d) => {
              d.filter_full_name = $('#filter_full_name').val();
              d.filter_rol_name = $('#filter_rol_name').val();
              d.filter_email = $('#filter_email').val();
            }
          },
          columns: [
            { data: 'full_name', width: '22%' },
            { data: 'email', width: '38%' },
            { data: 'rol_name', width: '20%' },
            { data: 'actions', width: '20%', orderable: false, searchable: false }
          ],
          order: [],
          dom: AdminDatatable.dom,
          lengthMenu: AdminDatatable.lengthMenu,
          pageLength: AdminDatatable.pageLength,
          language: AdminDatatable.language,
          initComplete: function() {
            AdminDatatable.initComplete(this.api());
          }
        });
      }
    }));
  });
</script>
