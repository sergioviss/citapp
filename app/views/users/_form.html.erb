<% modal = local_assigns.fetch(:modal, false) %>
<% form_title = local_assigns.fetch(:form_title, @title) %>
<% roles = local_assigns.fetch(:roles, @roles) %>
<% mode = local_assigns.fetch(:mode, @mode) %>
<% read_only = form_title == 'Detalles' %>
<% form_id = if !modal
  'new_user_form'
elsif read_only
  'user-show-modal'
elsif mode == 'new'
  'create-user-form'
else
  'record-modal-form'
end %>

<%= form_with model: user,
              id: form_id,
              local: true,
              html: {
                class: 'space-y-5',
                data: {
                  turbo: false,
                  modal_form: (modal && !read_only && mode != 'new')
                }
              } do |form| %>
  <% if !modal && user.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(user.errors.count, 'error') %> prohibited this user from being saved:</h2>
      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <label for="actionName">Nombre completo:</label>
    <%= form.text_field :full_name, autofocus: true, class: 'form-input', placeholder: "Ingresa Nombre completo", required: !read_only, disabled: read_only %>
  </div>

  <div class="<%= modal ? 'space-y-4' : 'grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4' %>">
    <div class="<%= modal ? '' : 'md:col-span-2' %>">
      <label for="actionEmail">Email:</label>
      <div class="flex flex-1">
        <div class="bg-[#eee] flex justify-center items-center ltr:rounded-l-md rtl:rounded-r-md px-3 font-semibold border ltr:border-r-0 rtl:border-l-0 border-[#e0e6ed] dark:border-[#17263c] dark:bg-[#1b2e4b]">@</div>
        <%= form.email_field :email, type: "email", class: 'form-input ltr:rounded-l-none rtl:rounded-r-none', required: !read_only, disabled: read_only %>
      </div>
    </div>
    <div class="<%= modal ? '' : 'md:col-span-2' %>">
      <label for="actionWeb">Rol:</label>
      <%= form.collection_select :rol_id, roles, :id, :name, { prompt: 'Selecciona un rol' }, class: 'form-select flex-1', disabled: read_only, required: !read_only %>
    </div>
  </div>

  <% if mode == "new" && !read_only %>
    <div class="<%= modal ? 'space-y-4' : 'grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4' %>">
      <div class="<%= modal ? '' : 'md:col-span-2' %>">
        <label for="actionPassword">Contraseña:</label>
        <%= form.password_field :password, id: 'user_password', class: 'form-input', placeholder: "Ingresa Contraseña", minlength: User.minimum_password_length %>
      </div>
      <div class="<%= modal ? '' : 'md:col-span-2' %>">
        <label for="actionCpass">Confirmar Contraseña:</label>
        <%= form.password_field :password_confirmation, id: 'user_password_confirm', placeholder: "Ingresa Contraseña", class: 'form-input', minlength: User.minimum_password_length, 'equalTo': '#user_password' %>
      </div>
    </div>
  <% end %>

  <div class="flex items-center <%= modal ? 'justify-end' : 'justify-center' %>" style="margin-top: <%= modal ? '1.5rem' : '5em' %>;">
    <% if read_only %>
      <% if modal %>
        <button type="button" class="btn btn-outline-danger gap-2 ltr:mr-4 rtl:ml-4" @click="closeRecordModal()">Cerrar</button>
        <button type="button" class="btn btn-primary gap-2 datatable-action-edit" data-url="<%= edit_user_path(user) %>">Editar</button>
      <% else %>
        <%= link_to edit_user_path(user), class: 'btn btn-primary gap-2 ltr:mr-5 rtl:ml-5', data: { turbolinks: 'false' } do %>
          Editar
        <% end %>
        <%= link_to @user, class: "btn btn-danger gap-2", data: { turbo_method: :delete, turbo_confirm: '¿Estás seguro que deasea eliminar el rancho?' } do %>
          Eliminar
        <% end %>
      <% end %>
    <% else %>
      <% if modal %>
        <button type="button"
                class="btn btn-outline-danger gap-2 ltr:mr-4 rtl:ml-4"
                @click="<%= mode == 'new' ? 'closeCreateModal()' : 'closeRecordModal()' %>">
          Cancelar
        </button>
      <% end %>
      <button type="submit" class="btn btn-success gap-2">Guardar</button>
    <% end %>
  </div>
<% end %>
