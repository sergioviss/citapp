<div x-data="customizer">
    <div class="fixed inset-0 bg-[black]/60 z-[51] px-4 hidden transition-[display]" :class="{ '!block': showCustomizer }" @click="showCustomizer = false"></div>

    <nav class="bg-white fixed ltr:-right-[400px] rtl:-left-[400px] top-0 bottom-0 w-full max-w-[400px] shadow-[5px_0_25px_0_rgba(94,92,154,0.1)] transition-[right] duration-300 z-[51] dark:bg-[#0e1726] p-4" :class="{ 'ltr:!right-0 rtl:!left-0': showCustomizer }">
        <a href="javascript:;" class="bg-primary ltr:rounded-tl-full rtl:rounded-tr-full ltr:rounded-bl-full rtl:rounded-br-full absolute ltr:-left-12 rtl:-right-12 top-0 bottom-0 my-auto w-12 h-10 flex justify-center items-center text-white cursor-pointer" @click="showCustomizer = !showCustomizer">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="animate-[spin_3s_linear_infinite] w-5 h-5">
                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" />
                <path opacity="0.5" d="M13.7654 2.15224C13.3978 2 12.9319 2 12 2C11.0681 2 10.6022 2 10.2346 2.15224C9.74457 2.35523 9.35522 2.74458 9.15223 3.23463C9.05957 3.45834 9.0233 3.7185 9.00911 4.09799C8.98826 4.65568 8.70226 5.17189 8.21894 5.45093C7.73564 5.72996 7.14559 5.71954 6.65219 5.45876C6.31645 5.2813 6.07301 5.18262 5.83294 5.15102C5.30704 5.08178 4.77518 5.22429 4.35436 5.5472C4.03874 5.78938 3.80577 6.1929 3.33983 6.99993C2.87389 7.80697 2.64092 8.21048 2.58899 8.60491C2.51976 9.1308 2.66227 9.66266 2.98518 10.0835C3.13256 10.2756 3.3397 10.437 3.66119 10.639C4.1338 10.936 4.43789 11.4419 4.43786 12C4.43783 12.5581 4.13375 13.0639 3.66118 13.3608C3.33965 13.5629 3.13248 13.7244 2.98508 13.9165C2.66217 14.3373 2.51966 14.8691 2.5889 15.395C2.64082 15.7894 2.87379 16.193 3.33973 17C3.80568 17.807 4.03865 18.2106 4.35426 18.4527C4.77508 18.7756 5.30694 18.9181 5.83284 18.8489C6.07289 18.8173 6.31632 18.7186 6.65204 18.5412C7.14547 18.2804 7.73556 18.27 8.2189 18.549C8.70224 18.8281 8.98826 19.3443 9.00911 19.9021C9.02331 20.2815 9.05957 20.5417 9.15223 20.7654C9.35522 21.2554 9.74457 21.6448 10.2346 21.8478C10.6022 22 11.0681 22 12 22C12.9319 22 13.3978 22 13.7654 21.8478C14.2554 21.6448 14.6448 21.2554 14.8477 20.7654C14.9404 20.5417 14.9767 20.2815 14.9909 19.902C15.0117 19.3443 15.2977 18.8281 15.781 18.549C16.2643 18.2699 16.8544 18.2804 17.3479 18.5412C17.6836 18.7186 17.927 18.8172 18.167 18.8488C18.6929 18.9181 19.2248 18.7756 19.6456 18.4527C19.9612 18.2105 20.1942 17.807 20.6601 16.9999C21.1261 16.1929 21.3591 15.7894 21.411 15.395C21.4802 14.8691 21.3377 14.3372 21.0148 13.9164C20.8674 13.7243 20.6602 13.5628 20.3387 13.3608C19.8662 13.0639 19.5621 12.558 19.5621 11.9999C19.5621 11.4418 19.8662 10.9361 20.3387 10.6392C20.6603 10.4371 20.8675 10.2757 21.0149 10.0835C21.3378 9.66273 21.4803 9.13087 21.4111 8.60497C21.3592 8.21055 21.1262 7.80703 20.6602 7C20.1943 6.19297 19.9613 5.78945 19.6457 5.54727C19.2249 5.22436 18.693 5.08185 18.1671 5.15109C17.9271 5.18269 17.6837 5.28136 17.3479 5.4588C16.8545 5.71959 16.2644 5.73002 15.7811 5.45096C15.2977 5.17191 15.0117 4.65566 14.9909 4.09794C14.9767 3.71848 14.9404 3.45833 14.8477 3.23463C14.6448 2.74458 14.2554 2.35523 13.7654 2.15224Z" stroke="currentColor" stroke-width="1.5" />
            </svg>
        </a>
        <div class="overflow-y-auto overflow-x-hidden perfect-scrollbar h-full">
            <div class="text-center relative pb-5">
                <a href="javascript:;" class="absolute top-0 ltr:right-0 rtl:left-0 opacity-30 hover:opacity-100 dark:text-white" @click="showCustomizer = false">

                    <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </a>
                <h4 class="mb-1 dark:text-white">TEMPLATE CUSTOMIZER</h4>
                <p class="text-white-dark">Set preferences that will be saved to your project configuration.</p>
            </div>

            <%# ====== COLOR THEME SECTION ====== %>
            <div class="border border-dashed border-[#e0e6ed] dark:border-[#1b2e4b] rounded-md mb-3 p-3">
                <h5 class="mb-1 text-base dark:text-white leading-none">Color Theme</h5>
                <p class="text-white-dark text-xs">Choose a predefined color palette.</p>
                <div class="grid grid-cols-4 gap-2 mt-3">
                    <template x-for="(colors, name) in availableThemes" :key="name">
                        <div>
                            <button type="button" class="theme-swatch" :class="{ 'active': colorTheme === name }"
                                :style="'background: linear-gradient(135deg, ' + colors.primary + ' 50%, ' + colors.secondary + ' 50%)'"
                                @click="setColorTheme(name)">
                            </button>
                            <div class="theme-swatch-name dark:text-white-dark" x-text="name"></div>
                        </div>
                    </template>
                </div>
            </div>

            <%# ====== CUSTOM COLORS SECTION ====== %>
            <div class="border border-dashed border-[#e0e6ed] dark:border-[#1b2e4b] rounded-md mb-3 p-3">
                <h5 class="mb-1 text-base dark:text-white leading-none">Custom Colors</h5>
                <p class="text-white-dark text-xs">Define your own color palette.</p>
                <div class="space-y-2 mt-3">
                    <template x-for="colorKey in ['primary', 'secondary', 'success', 'danger', 'warning', 'info']" :key="colorKey">
                        <div class="color-picker-wrapper">
                            <label x-text="colorKey" class="capitalize dark:text-white-dark"></label>
                            <input type="color" :value="customColors[colorKey]"
                                @input="updateCustomColor(colorKey, $event.target.value)">
                            <span class="text-xs text-white-dark" x-text="customColors[colorKey]"></span>
                        </div>
                    </template>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary mt-3 w-full" @click="applyCustomColors()">
                    Apply Custom Colors
                </button>
            </div>

            <%# ====== COLOR SCHEME SECTION (light/dark/system) ====== %>
            <div class="border border-dashed border-[#e0e6ed] dark:border-[#1b2e4b] rounded-md mb-3 p-3">
                <h5 class="mb-1 text-base dark:text-white leading-none">Color Scheme</h5>
                <p class="text-white-dark text-xs">Overall light or dark presentation.</p>
                <div class="grid grid-cols-3 gap-2 mt-3">
                    <button type="button" class="btn" :class="[$store.app.theme === 'light' ? 'btn-primary' : 'btn-outline-primary']" @click="$store.app.toggleTheme('light'); saveLayoutConfig('scheme', 'light')">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 ltr:mr-2 rtl:ml-2"><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"></circle><path d="M12 2V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><path d="M12 20V22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><path d="M4 12L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><path d="M22 12L20 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
                        Light
                    </button>
                    <button type="button" class="btn" :class="[$store.app.theme === 'dark' ? 'btn-primary' : 'btn-outline-primary']" @click="$store.app.toggleTheme('dark'); saveLayoutConfig('scheme', 'dark')">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 ltr:mr-2 rtl:ml-2"><path d="M21.0672 11.8568L20.4253 11.469L21.0672 11.8568ZM12.1432 2.93276L11.7553 2.29085V2.29085L12.1432 2.93276ZM21.25 12C21.25 17.1086 17.1086 21.25 12 21.25V22.75C17.9371 22.75 22.75 17.9371 22.75 12H21.25ZM12 21.25C6.89137 21.25 2.75 17.1086 2.75 12H1.25C1.25 17.9371 6.06294 22.75 12 22.75V21.25ZM2.75 12C2.75 6.89137 6.89137 2.75 12 2.75V1.25C6.06294 1.25 1.25 6.06294 1.25 12H2.75Z" fill="currentColor"></path></svg>
                        Dark
                    </button>
                    <button type="button" class="btn" :class="[$store.app.theme === 'system' ? 'btn-primary' : 'btn-outline-primary']" @click="$store.app.toggleTheme('system'); saveLayoutConfig('scheme', 'system')">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 ltr:mr-2 rtl:ml-2"><path d="M3 9C3 6.17157 3 4.75736 3.87868 3.87868C4.75736 3 6.17157 3 9 3H15C17.8284 3 19.2426 3 20.1213 3.87868C21 4.75736 21 6.17157 21 9V14C21 15.8856 21 16.8284 20.4142 17.4142C19.8284 18 18.8856 18 17 18H7C5.11438 18 4.17157 18 3.58579 17.4142C3 16.8284 3 15.8856 3 14V9Z" stroke="currentColor" stroke-width="1.5"></path></svg>
                        System
                    </button>
                </div>
            </div>

            <%# ====== NAVIGATION POSITION ====== %>
            <div class="border border-dashed border-[#e0e6ed] dark:border-[#1b2e4b] rounded-md mb-3 p-3">
                <h5 class="mb-1 text-base dark:text-white leading-none">Navigation Position</h5>
                <p class="text-white-dark text-xs">Select the primary navigation paradigm for your app.</p>
                <div class="grid grid-cols-3 gap-2 mt-3">
                    <button type="button" class="btn" :class="[$store.app.menu === 'horizontal' ? 'btn-primary' : 'btn-outline-primary']" @click="$store.app.toggleMenu('horizontal'); saveLayoutConfig('menu', 'horizontal')">Horizontal</button>
                    <button type="button" class="btn" :class="[$store.app.menu === 'vertical' ? 'btn-primary' : 'btn-outline-primary']" @click="$store.app.toggleMenu('vertical'); saveLayoutConfig('menu', 'vertical')">Vertical</button>
                    <button type="button" class="btn" :class="[$store.app.menu === 'collapsible-vertical' ? 'btn-primary' : 'btn-outline-primary']" @click="$store.app.toggleMenu('collapsible-vertical'); saveLayoutConfig('menu', 'collapsible-vertical')">Collapsible</button>
                </div>
                <div class="mt-5 text-primary">
                    <label class="inline-flex mb-0">
                        <input x-model="$store.app.semidark" type="checkbox" :value="true" class="form-checkbox" @change="$store.app.toggleSemidark(); saveLayoutConfig('semidark', $store.app.semidark)" />
                        <span>Semi Dark (Sidebar & Header)</span>
                    </label>
                </div>
            </div>

            <%# ====== LAYOUT STYLE ====== %>
            <div class="border border-dashed border-[#e0e6ed] dark:border-[#1b2e4b] rounded-md mb-3 p-3">
                <h5 class="mb-1 text-base dark:text-white leading-none">Layout Style</h5>
                <p class="text-white-dark text-xs">Select the primary layout style for your app.</p>
                <div class="flex gap-2 mt-3">
                    <button type="button" class="btn flex-auto" :class="[$store.app.layout === 'boxed-layout' ? 'btn-primary' : 'btn-outline-primary']" @click="$store.app.toggleLayout('boxed-layout'); saveLayoutConfig('style', 'boxed-layout')">Box</button>
                    <button type="button" class="btn flex-auto" :class="[$store.app.layout === 'full' ? 'btn-primary' : 'btn-outline-primary']" @click="$store.app.toggleLayout('full'); saveLayoutConfig('style', 'full')">Full</button>
                </div>
            </div>

            <%# ====== DIRECTION ====== %>
            <div class="border border-dashed border-[#e0e6ed] dark:border-[#1b2e4b] rounded-md mb-3 p-3">
                <h5 class="mb-1 text-base dark:text-white leading-none">Direction</h5>
                <p class="text-white-dark text-xs">Select the direction for your app.</p>
                <div class="flex gap-2 mt-3">
                    <button type="button" class="btn flex-auto" :class="[$store.app.rtlClass === 'ltr' ? 'btn-primary' : 'btn-outline-primary']" @click="$store.app.toggleRTL('ltr'); saveLayoutConfig('direction', 'ltr')">LTR</button>
                    <button type="button" class="btn flex-auto" :class="[$store.app.rtlClass === 'rtl' ? 'btn-primary' : 'btn-outline-primary']" @click="$store.app.toggleRTL('rtl'); saveLayoutConfig('direction', 'rtl')">RTL</button>
                </div>
            </div>

            <%# ====== NAVBAR TYPE ====== %>
            <div class="border border-dashed border-[#e0e6ed] dark:border-[#1b2e4b] rounded-md mb-3 p-3">
                <h5 class="mb-1 text-base dark:text-white leading-none">Navbar Type</h5>
                <p class="text-white-dark text-xs">Sticky or Floating.</p>
                <div class="mt-3 flex items-center gap-3 text-primary">
                    <label class="inline-flex mb-0">
                        <input x-model="$store.app.navbar" type="radio" value="navbar-sticky" class="form-radio" @change="$store.app.toggleNavbar(); saveLayoutConfig('navbar', 'navbar-sticky')" />
                        <span>Sticky</span>
                    </label>
                    <label class="inline-flex mb-0">
                        <input x-model="$store.app.navbar" type="radio" value="navbar-floating" class="form-radio" @change="$store.app.toggleNavbar(); saveLayoutConfig('navbar', 'navbar-floating')" />
                        <span>Floating</span>
                    </label>
                    <label class="inline-flex mb-0">
                        <input x-model="$store.app.navbar" type="radio" value="navbar-static" class="form-radio" @change="$store.app.toggleNavbar(); saveLayoutConfig('navbar', 'navbar-static')" />
                        <span>Static</span>
                    </label>
                </div>
            </div>

            <%# ====== ANIMATION ====== %>
            <div class="border border-dashed border-[#e0e6ed] dark:border-[#1b2e4b] rounded-md mb-3 p-3">
                <h5 class="mb-1 text-base dark:text-white leading-none">Router Transition</h5>
                <p class="text-white-dark text-xs">Animation of main content.</p>
                <div class="mt-3">
                    <select x-model="$store.app.animation" class="form-select border-primary text-primary" @change="$store.app.toggleAnimation(); saveLayoutConfig('animation', $store.app.animation)">
                        <option value="">None</option>
                        <option value="animate__fadeIn">Fade</option>
                        <option value="animate__fadeInDown">Fade Down</option>
                        <option value="animate__fadeInUp">Fade Up</option>
                        <option value="animate__fadeInLeft">Fade Left</option>
                        <option value="animate__fadeInRight">Fade Right</option>
                        <option value="animate__slideInDown">Slide Down</option>
                        <option value="animate__slideInLeft">Slide Left</option>
                        <option value="animate__slideInRight">Slide Right</option>
                        <option value="animate__zoomIn">Zoom In</option>
                    </select>
                </div>
            </div>

            <%# ====== LOGO SETTINGS SECTION ====== %>
            <div class="border border-dashed border-[#e0e6ed] dark:border-[#1b2e4b] rounded-md mb-3 p-3">
                <h5 class="mb-1 text-base dark:text-white leading-none">Logo Settings</h5>
                <p class="text-white-dark text-xs">Customize your brand identity.</p>
                <div class="space-y-3 mt-3">
                    <div>
                        <label class="text-xs dark:text-white-dark mb-1 block">Logo Name</label>
                        <input type="text" x-model="logo.text" class="form-input text-xs" @change="saveLogoConfig('text', logo.text)" placeholder="Enter application name">
                    </div>
                    <div>
                        <label class="text-xs dark:text-white-dark mb-1 block">Logo Image URL</label>
                        <input type="text" x-model="logo.image" class="form-input text-xs" @change="saveLogoConfig('image', logo.image)" placeholder="cuatropuntocero_logo.png">
                    </div>
                    <div class="text-primary">
                        <label class="inline-flex mb-0 items-center">
                            <input x-model="logo.show_image" type="checkbox" class="form-checkbox" @change="saveLogoConfig('show_image', logo.show_image)" />
                            <span class="text-xs">Show Logo Image</span>
                        </label>
                    </div>
                    <div class="text-primary">
                        <label class="inline-flex mb-0 items-center">
                            <input x-model="logo.show_text" type="checkbox" class="form-checkbox" @change="saveLogoConfig('show_text', logo.show_text)" />
                            <span class="text-xs">Show Logo Name</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </nav>
</div>

<script>
    document.addEventListener("alpine:init", () => {
        Alpine.data("customizer", () => ({
            showCustomizer: false,
            colorTheme: '<%= active_theme_preset %>',
            availableThemes: <%= raw available_themes_json %>,
            customColors: <%= raw active_theme_colors.to_json %>,
            logo: <%= raw theme_layout_config[:logo].to_json %>,

            setColorTheme(name) {
                this.colorTheme = name;
                const colors = this.availableThemes[name];
                if (colors) {
                    this.applyThemeColors(colors);
                    this.customColors = { ...colors };
                }
                document.documentElement.setAttribute('data-theme', name);
                // Guardar en servidor
                this.saveThemeConfig(name, colors);
            },

            updateCustomColor(key, value) {
                this.customColors[key] = value;
            },

            applyCustomColors() {
                this.colorTheme = 'custom';
                this.applyThemeColors(this.customColors);
                document.documentElement.setAttribute('data-theme', 'custom');
                // Guardar en servidor
                this.saveThemeConfig('custom', this.customColors);
            },

            applyThemeColors(colors) {
                const root = document.documentElement;
                root.style.setProperty('--color-primary', colors.primary);
                root.style.setProperty('--color-secondary', colors.secondary);
                root.style.setProperty('--color-success', colors.success);
                root.style.setProperty('--color-danger', colors.danger);
                root.style.setProperty('--color-warning', colors.warning);
                root.style.setProperty('--color-info', colors.info);
            },

            saveThemeConfig(preset, colors) {
                const data = {
                    theme: {
                        preset: preset,
                        custom_colors: colors || this.customColors
                    }
                };
                fetch('/theme/update', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
                    body: JSON.stringify(data)
                }).catch(err => console.warn('Theme save failed:', err));
            },

            saveLayoutConfig(key, value) {
                const data = { layout_config: {} };
                data.layout_config[key] = value;
                fetch('/theme/update', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
                    body: JSON.stringify(data)
                }).catch(err => console.warn('Layout save failed:', err));
            },

            saveLogoConfig(key, value) {
                const data = { logo: {} };
                data.logo[key] = value;
                fetch('/theme/update', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
                    body: JSON.stringify(data)
                }).catch(err => console.warn('Logo save failed:', err));
                this.applyLogoVisibility();
                if (key === 'text') this.updateDocumentTitle(value);
            },

            updateDocumentTitle(appName) {
                const name = (appName || '').trim();
                const pageTitle = document.documentElement.dataset.pageTitle;
                document.title = [pageTitle, name].filter(Boolean).join(' — ');
                document.querySelectorAll('[data-theme-logo-text]').forEach((el) => {
                    el.textContent = name;
                });
            },

            applyLogoVisibility() {
                document.querySelectorAll('[data-theme-logo-image]').forEach((el) => {
                    el.style.display = this.logo.show_image ? '' : 'none';
                });
                document.querySelectorAll('[data-theme-logo-text]').forEach((el) => {
                    el.style.display = this.logo.show_text ? '' : 'none';
                });
            }
        }));
    });
</script>
