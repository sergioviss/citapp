<% content_for :title, "Cambiar contraseña" %>

<%= render "devise/shared/auth_shell", title: "Cambiar contraseña", subtitle: "Elige una contraseña nueva para tu cuenta" do %>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }, class: "mt-8 dark:text-white") do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div>
            <label for="user_password" class="auth-label font-semibold">Nueva contraseña</label>
            <div class="relative text-white-dark">
                <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-input ps-10 placeholder:text-white-dark", placeholder: "Ingresa tu nueva contraseña", minlength: @minimum_password_length %>
                <%= render "devise/shared/password_icon" %>
            </div>
            <% if @minimum_password_length %>
                <p class="mt-1 text-xs text-white-dark">Mínimo <%= @minimum_password_length %> caracteres</p>
            <% end %>
        </div>
        <div style="margin-top: 1.15rem;">
            <label for="user_password_confirmation" class="auth-label font-semibold">Confirmar contraseña</label>
            <div class="relative text-white-dark">
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input ps-10 placeholder:text-white-dark", placeholder: "Confirma tu nueva contraseña" %>
                <%= render "devise/shared/password_icon" %>
            </div>
        </div>

        <button type="submit" class="auth-submit !mt-6 w-full rounded-md border-0 py-3 text-sm font-bold uppercase tracking-widest transition-all duration-300 hover:opacity-90 hover:shadow-lg">
            Guardar contraseña
        </button>
    <% end %>
<% end %>
