<%= render 'operations/shared/assets' %>
<div class="ops">
<h1>Venta #<%= @sale.id %></h1>
<p><%= @sale.client.name %> · <%= {"draft"=>"Borrador", "posted"=>"Publicada", "cancelled"=>"Cancelada"}[@sale.status] %> · <%= @sale.currency %></p>
<p><strong>Cajero:</strong> <%= @sale.created_by.full_name %><% if @sale.exchange_rate %> · Tipo de cambio: 1 USD = <%= @sale.exchange_rate %> MXN<% end %></p>
<p>Descuento: <%= @sale.discount_percent %>% · Total pagado: <%= @payments.select(&:receipt?).sum { |payment| payment.tendered_amount || payment.amount } %> <%= @sale.currency %> · Cambio: <%= @payments.sum { |payment| payment.change_amount || 0 } %> <%= @sale.currency %></p>
<% if @sale.notes.present? %><p><strong>Notas:</strong> <%= @sale.notes %></p><% end %>
<div class="grid"><section class="card"><h2>Total histórico</h2><p class="money"><%= @sale.total %> <%= @sale.currency %></p><p>Descuento: <%= @sale.discount_total %></p></section><section class="card"><h2>Saldo</h2><p class="money"><%= @sale.computed_balance %> <%= @sale.currency %></p><p class="muted">Un saldo negativo queda a favor del cliente. Los saldos de borradores son provisionales.</p></section></div>
<section class="card table-wrap"><h2>Partidas</h2><table><thead><tr><th>Servicio</th><th>Atendió</th><th>Cantidad</th><th>Precio</th><th>Descuento</th><th>Total</th></tr></thead><tbody><% @items.each do |item| %><tr><td><%= item.description %></td><td><%= item.employee&.name || "Sin asignar" %></td><td><%= item.quantity %></td><td><%= item.unit_price %></td><td><%= item.discount_amount %></td><td><%= item.total %></td></tr><% end %></tbody></table>
<div class="actions"><% unless @sale.cancelled? %><%= button_to "Cancelar venta", cancel_operations_sale_path(@sale), class: "btn btn-outline-danger", form: { data: { confirm: "¿Cancelar esta venta? El historial y los cobros se conservarán." } } %><% end %></div>
<% if @sale.draft? && @payments.empty? %><%= link_to 'Completar venta y pagos', edit_operations_sale_path(@sale), class: 'btn btn-outline-primary' %><% end %></section>
<% if @attempts.any?(&:pending?) %><section class="card"><h2>Cobros pendientes de confirmación</h2><p>El importe queda reservado hasta recuperar la confirmación del cobro.</p><% @attempts.select(&:pending?).each do |attempt| %><p><%= attempt.amount %> <%= attempt.currency %> · <%= attempt.created_at %></p><%= button_to "Consultar y completar cobro", external_operations_sale_payments_path(@sale), params: {payment: {amount: attempt.amount, method: attempt.method, idempotency_key: attempt.idempotency_key}} %><% end %></section><% end %>
<section class="card"><h2>Movimientos confirmados</h2><% if @payments.empty? %><p>No hay movimientos.</p><% end %><% @payments.each do |payment| %><article><p><strong><%= payment.receipt? ? "Cobro" : "Devolución" %></strong> · <%= payment.amount %> <%= @sale.currency %> · <%= {"cash"=>"Efectivo","card"=>"Tarjeta","transfer"=>"Transferencia"}[payment.method] %><% if payment.cash_receipt? %> · Cambio: <%= payment.change_amount %><% end %></p><% if payment.reason.present? %><p><%= payment.reason %></p><% end %>
<% if payment.receipt? && payment.refundable_remaining.positive? %><details><summary>Registrar devolución de este cobro</summary><%= form_with scope: :payment, url: refund_operations_sale_payments_path(@sale), class: "fields" do |f| %><%= f.hidden_field :idempotency_key, value: SecureRandom.uuid %><%= f.hidden_field :original_payment_id, value: payment.id %><div><%= f.label :amount, "Importe a devolver", for: "refund_amount_#{payment.id}" %><%= f.number_field :amount, min: "0.01", max: payment.refundable_remaining, step: "0.01", required: true, id: "refund_amount_#{payment.id}" %></div><div><%= f.label :method, "Método de devolución", for: "refund_method_#{payment.id}" %><%= f.select :method, [["Efectivo","cash"],["Tarjeta","card"],["Transferencia","transfer"]], {selected: payment.method}, id: "refund_method_#{payment.id}" %></div><div><%= f.label :reason, "Motivo", for: "refund_reason_#{payment.id}" %><%= f.text_field :reason, required: true, id: "refund_reason_#{payment.id}" %></div><%= f.submit "Registrar devolución", class: "button" %><% end %></details><% end %></article><% end %></section>

</div>
