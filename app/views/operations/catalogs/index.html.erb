<%= render 'operations/shared/assets' %>
<% singular = @kind.singularize; title = { 'clients' => 'Clientes', 'services' => 'Servicios', 'employees' => 'Empleados' }.fetch(@kind) %>
<div class="ops" data-catalog="<%= singular %>" data-catalog-url="<%= url_for(controller: @kind, action: :index) %>">
  <div class="ops-heading"><div><h1><%= title %></h1></div>
    <button type="button" class="btn btn-primary gap-2" data-catalog-new>＋ Agregar <%= { 'clients' => 'cliente', 'services' => 'servicio', 'employees' => 'empleado' }.fetch(@kind) %></button>
  </div>
  <%= render 'operations/shared/table', url: url_for(controller: @kind, action: :datatable, format: :json), headings: { 'clients' => ['Nombre', 'Teléfono', 'Email', 'Acciones'], 'services' => ['Nombre', 'Categoría', 'Duración', 'Precio', 'Estado', 'Acciones'], 'employees' => ['Nombre', 'Estado', 'Acciones'] }.fetch(@kind) %>
  <dialog class="ops-dialog panel" id="catalog-dialog" aria-labelledby="catalog-title">
    <div class="ops-heading"><h2 id="catalog-title">Agregar registro</h2><button type="button" data-close-dialog aria-label="Cerrar">✕</button></div>
    <%= form_with scope: singular, url: url_for(controller: @kind, action: :index), data: { catalog_form: true } do |f| %>
      <%= f.label :name, 'Nombre' %><%= f.text_field :name, required: true, maxlength: 200 %>
      <% if @kind == 'clients' %>
        <%= f.label :phone, 'Teléfono' %><%= f.telephone_field :phone %>
        <%= f.label :email, 'Email' %><%= f.email_field :email %>
      <% elsif @kind == 'services' %>
        <%= f.label :category_id, 'Categoría' %><%= f.select :category_id, ServiceCategory.order(:name).map { |category| [category.name, category.id] } %>
        <details><summary>Crear una categoría nueva</summary><%= f.label :new_category_name, 'Nombre de la categoría nueva' %><%= f.text_field :new_category_name, maxlength: 200 %><p class="muted">Al escribir un nombre, el servicio se guardará en esa categoría.</p></details>
        <div class="fields"><div><%= f.label :duration_minutes, 'Duración (minutos)' %><%= f.number_field :duration_minutes, min: 1, required: true %></div>
          <div><%= f.label :price, "Precio (#{BusinessSetting.current!.currency})" %><%= f.number_field :price, min: 0, step: '0.01', required: true %></div></div>
      <% end %>
      <% unless @kind == 'clients' %><label class="ops-check"><%= f.check_box :active, checked: true %> Activo</label><% end %>
      <div class="actions"><button type="button" class="btn btn-outline-danger" data-close-dialog>Cancelar</button><%= f.submit 'Guardar', class: 'btn btn-primary' %></div>
    <% end %>
  </dialog>
</div>
