<%#
  locals: field, label_text, collection, select_id
%>
<div class="datatable-multiselect-filter relative flex items-center gap-2"
     :class="{ 'datatable-multiselect-filter--open': open }"
     x-data="datatableMultiselectFilter('<%= select_id %>')"
     @click.outside="open = false">
  <span class="text-sm font-semibold whitespace-nowrap mb-0 text-[#888ea8]"><%= label_text %>:</span>
  <button type="button"
          class="form-input h-[38px] min-w-[11rem] max-w-[14rem] flex items-center justify-between gap-2 text-left py-2"
          @click="open = !open">
    <span class="truncate text-sm" x-text="summary"></span>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 opacity-60">
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </button>
  <div x-show="open"
       x-cloak
       x-transition
       class="datatable-multiselect-dropdown">
    <% collection.each do |item| %>
      <label class="flex items-center gap-2 py-1.5 text-sm cursor-pointer hover:text-primary">
        <input type="checkbox"
               class="form-checkbox"
               value="<%= item %>"
               :checked="selected.includes('<%= j item.to_s %>')"
               @change="toggle('<%= j item.to_s %>')">
        <span><%= item %></span>
      </label>
    <% end %>
    <button type="button" class="btn btn-sm btn-outline-danger mt-2 w-full" @click="clear()">Limpiar</button>
  </div>
  <select id="<%= select_id %>"
          name="filter_<%= field %>[]"
          multiple
          class="hidden datatable-filter-input"
          data-filter-field="<%= field %>">
    <% collection.each do |item| %>
      <option value="<%= item %>"><%= item %></option>
    <% end %>
  </select>
</div>
